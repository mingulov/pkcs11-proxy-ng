# Dictionary for fuzz_attribute: attribute proto<->Rust edge.
# Common CKA_* type ids as 8-byte little-endian (the harness reads
# attr_type with u64::from_le_bytes) plus kind-selector and depth
# boundary bytes.

# CKA_CLASS, CKA_TOKEN, CKA_PRIVATE, CKA_LABEL
"\x00\x00\x00\x00\x00\x00\x00\x00"
"\x01\x00\x00\x00\x00\x00\x00\x00"
"\x02\x00\x00\x00\x00\x00\x00\x00"
"\x03\x00\x00\x00\x00\x00\x00\x00"
# CKA_VALUE, CKA_KEY_TYPE, CKA_SENSITIVE, CKA_ENCRYPT
"\x11\x00\x00\x00\x00\x00\x00\x00"
"\x00\x01\x00\x00\x00\x00\x00\x00"
"\x03\x01\x00\x00\x00\x00\x00\x00"
"\x04\x01\x00\x00\x00\x00\x00\x00"
# CKA_MODULUS, CKA_VENDOR_DEFINED, wrapping templates
"\x20\x01\x00\x00\x00\x00\x00\x00"
"\x00\x00\x00\x80\x00\x00\x00\x00"
# all-ones / max-id edges
"\xFF\xFF\xFF\xFF\xFF\xFF\xFF\xFF"
"\xFE\xFF\xFF\xFF\xFF\xFF\xFF\xFF"
