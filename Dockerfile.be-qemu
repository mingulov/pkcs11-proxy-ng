# Dockerfile.be-qemu — big-endian cross-test image (T6a).
#
# x86_64 builder that compiles the workspace for s390x-unknown-linux-gnu
# (big-endian) and runs the test binaries under qemu-s390x. The workspace
# is mounted at /workspace at run time (see scripts/run-be-qemu-test.sh);
# nothing is copied at build time, so this image never goes stale.
#
# Usage (via the script):
#   scripts/run-be-qemu-test.sh
#
# Manual equivalent:
#   docker build -f Dockerfile.be-qemu -t pkcs11-proxy-ng-be-qemu .
#   docker run --rm -v "$PWD:/workspace:ro" -v be-cargo-cache:/root/.cargo \
#     -e CARGO_TARGET_DIR=/tmp/be-target pkcs11-proxy-ng-be-qemu \
#     cargo test --target s390x-unknown-linux-gnu -p pkcs11-proxy-ng-types

# Deferred T22 F6: base pinned by digest (tag kept for readability; the
# digest is what Docker pulls). Re-pin with the registry's current digest
# when moving Debian versions.
FROM debian:13.6@sha256:f324c7ff54321e8d9c588493a20244965938ce0aa50bbd1022d38010e9ffc4b1

# Pinned to the receipted toolchain (see task-t6a-report.md); override with
# --build-arg RUST_TOOLCHAIN=<version> to re-validate against a newer rustc.
ARG RUST_TOOLCHAIN=1.98.1

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        ca-certificates curl git pkg-config python3 \
        gcc libc6-dev gcc-s390x-linux-gnu libc6-dev-s390x-cross \
        qemu-user-static protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

# Deferred T22 F6: versioned rustup bootstrap (not the floating
# install pipe) installing RUST_TOOLCHAIN, with the init binary's
# SHA256 verified before execute. Hashes below are the published
# static.rust-lang.org rustup-init.sha256 values for 1.29.1.
ARG RUSTUP_VERSION=1.29.1
ARG RUSTUP_SHA256_AMD64=dda7234360b7f578ca8b0ddcb80145646fa61a67c1720a5abc7051b35c9fcb71
ARG RUSTUP_SHA256_ARM64=15f6e4ce9f583b929c996c91562bad6d4454f3281de858b02cdfdef615fac433
RUN set -eu; \
    ARCH="$(uname -m)"; \
    case "$ARCH" in \
        x86_64)  RUST_TRIPLE=x86_64-unknown-linux-gnu;  RUSTUP_SHA256="${RUSTUP_SHA256_AMD64}" ;; \
        aarch64) RUST_TRIPLE=aarch64-unknown-linux-gnu; RUSTUP_SHA256="${RUSTUP_SHA256_ARM64}" ;; \
        *) echo "unsupported arch $ARCH" >&2; exit 1 ;; \
    esac; \
    curl -fsSL "https://static.rust-lang.org/rustup/archive/${RUSTUP_VERSION}/${RUST_TRIPLE}/rustup-init" -o /tmp/rustup-init; \
    echo "${RUSTUP_SHA256}  /tmp/rustup-init" | sha256sum -c -; \
    chmod +x /tmp/rustup-init; \
    /tmp/rustup-init -y --default-toolchain "${RUST_TOOLCHAIN}" --profile minimal \
        --target s390x-unknown-linux-gnu; \
    rm /tmp/rustup-init

ENV PATH="/root/.cargo/bin:${PATH}"
ENV CARGO_TARGET_S390X_UNKNOWN_LINUX_GNU_LINKER="s390x-linux-gnu-gcc"
# qemu needs the cross sysroot so s390x glibc binaries find their loader/libc.
ENV CARGO_TARGET_S390X_UNKNOWN_LINUX_GNU_RUNNER="qemu-s390x-static -L /usr/s390x-linux-gnu"

WORKDIR /workspace
