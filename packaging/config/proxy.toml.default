# pkcs11-proxy-ng default configuration.
#
# Edit [backend].module before starting the daemon. The shipped value
# is a placeholder — the daemon refuses to start until you replace it
# with a real path to a PKCS#11 .so on the host. The shipped listener
# is loopback-only for local use; to serve other hosts, see the mTLS
# template under [listener.remote] below.
#
# Eight values in this file can also be overridden at runtime by env
# vars (each marked with an "Override:" comment below; the full list is
# printed by `pkcs11-proxy-ng --print-env-vars`):
#   PKCS11_PROXY_BIND, PKCS11_PROXY_BACKEND_MODULE,
#   PKCS11_PROXY_BACKEND_ARGS, PKCS11_PROXY_MECHANISMS_CONFIG,
#   PKCS11_PROXY_ALLOW_INSECURE,
#   PKCS11_PROXY_RESILIENCE_METRICS_SOCKET,
#   PKCS11_PROXY_RESILIENCE_FIND_THRESHOLD,
#   PKCS11_PROXY_TEST_HOOKS_CONTROL_SOCKET
# Everything else comes from this file. It is suitable for use as a
# Kubernetes ConfigMap with secrets/paths injected by the deployment.

[backend]
# REQUIRED. Path to the backend PKCS#11 module (HSM driver, SoftHSM2,
# kryoptic, NSS softokn, etc.).
# Override:  PKCS11_PROXY_BACKEND_MODULE=/usr/lib/softhsm/libsofthsm2.so
module = "/CHANGE_ME/path/to/backend.so"

# Optional backend initialize args (vendor-specific). Most backends
# don't need this.
# Override:  PKCS11_PROXY_BACKEND_ARGS="..."
# initialize_args = ""

[proxy]
# Backend-call timeout (also gRPC request timeout).
request_timeout_secs = 60

# Backend probe timeout at daemon startup. The daemon refuses to start
# if populate_slots() exceeds this. Raise for slow hardware HSMs.
startup_timeout_secs = 30

# Graceful shutdown grace period on SIGTERM/SIGINT.
# Kubernetes:  terminationGracePeriodSeconds should be >= this value.
shutdown_grace_secs = 30

# Consecutive backend-call failures before tonic-health flips to
# NOT_SERVING (drives k8s readiness probes).
backend_health_consecutive_failures = 3

# Reject NULL data pointers (len>0) and NULL mechanisms before the backend module.
# OFF by default (ADR-0010 transparent forwarding). Enable for modules that crash on them.
# sanitize_inputs = true

# Transport flood bounds (W1-L6-20): per-connection concurrent-request cap,
# HTTP/2 max concurrent streams, and load shedding (reject-over-limit with
# RESOURCE_EXHAUSTED instead of buffering unboundedly). The global backend
# breaker (max_concurrent_backend_calls) remains the primary gate.
# grpc_concurrency_limit_per_connection = 256
# grpc_max_concurrent_streams = 256
# grpc_load_shed = true

# Lease, context caps, ceilings, and pool sizes (defaults shown; every
# knob is documented in runbook §8d "Operator knob reference").
# lease_seconds = 3600
# max_contexts = 1
# max_message_bytes = 67108864
# max_concurrent_backend_calls = 200
# max_blocking_threads = 512
# eviction_interval_secs = 5
# http2_keepalive_interval_secs = 15
# http2_keepalive_timeout_secs = 5
# rate_limit_get_backend_interfaces = 0
# rate_limit_window_secs = 1
# login_lock_timeout_secs = 10
# max_stuck_backend_calls = 5
# mechanism_discovery = "transparent"

# [listener.local]
# Unix-domain listener with peer-credential auth.
# path = "/run/pkcs11-proxy-ng/proxy.sock"
# auth = "peer_cred"
# allow_insecure_unix = false

# [resilience]
# Pathological-population detection, metrics endpoint, attr coalescer.
# find_result_warn_threshold = 100000
# metrics_socket = "/run/pkcs11-proxy-ng/metrics.sock"
# Override:  PKCS11_PROXY_RESILIENCE_METRICS_SOCKET="/run/pkcs11-proxy-ng/metrics.sock"
# Override:  PKCS11_PROXY_RESILIENCE_FIND_THRESHOLD=100000
# coalesce_attributes = false

# [audit]
# Tamper-evident audit stream (off unless dir is set). Enabled audit
# with an auth="none" listener requires auth.anonymous_principal.
# dir = "/var/log/pkcs11-proxy-ng/audit"
# signing_key = "/etc/pkcs11-proxy-ng/audit.key"
# rotate_max_bytes = 67108864
# rotate_keep_files = 10
# checkpoint_interval_secs = 300
# data_plane = false
# channel_capacity = 4096
# fail_closed_reserve = 256

# [rate_limit]
# Per-principal quotas and per-slot login budget (all off unless set).
# per_principal_max_in_flight = 32
# per_principal_max_sessions = 8
# per_slot_failed_login_budget = 5
# per_slot_failed_login_cooldown_secs = 60

# [test_hooks]
# Hook-gated control endpoint (inert unless set; requires a
# native-owner-test-hooks build, default builds fail closed).
# Override:  PKCS11_PROXY_TEST_HOOKS_CONTROL_SOCKET="/run/pkcs11-proxy-ng/hooks.sock"
# control_socket = "/run/pkcs11-proxy-ng/hooks.sock"

[listener.remote]
# Default mode: loopback-only local use. The listener binds
# 127.0.0.1 only, so the unauthenticated plaintext settings below
# (auth = "none" + allow_insecure_tcp) are reachable solely from
# this host — the same posture as examples/configs/dev/proxy.toml.
# Override:  PKCS11_PROXY_BIND="127.0.0.1:7512"
bind = "127.0.0.1:7512"
auth = "none"
allow_insecure_tcp = true

# To serve other hosts, replace the [listener.remote] block above
# with the mTLS template below and remove allow_insecure_tcp.
# Serving other hosts over plaintext instead requires explicitly
# editing bind to a non-loopback address AND accepting the loud
# startup WARN for that posture — do NOT use it in untrusted
# networks.
#
# [listener.remote]
# bind = "0.0.0.0:7512"
# auth = "mtls"
# ca_cert = "/etc/pkcs11-proxy-ng/tls/ca.crt"
# server_cert = "/etc/pkcs11-proxy-ng/tls/server.crt"
# server_key = "/etc/pkcs11-proxy-ng/tls/server.key"

[auth]
# Token-level identity ACL is bypassed under auth="none". Configure
# [[auth.policy]] entries only when running with auth="mtls".
#
# Key policy entries by the client's SPKI fingerprint (primary form —
# stable across reissues with the same key):
# [[auth.policy]]
# identity = "x509:spki=<hex-sha256-of-client-public-key>"
# tokens = ["label:token-label"]
# Scalar tokens = "all" (or "*", an accepted alias) grants blanket access
# to all tokens.
# The legacy x509:issuer=<dn>;subject=<dn> form still works but is
# deprecated (the daemon logs a per-key migration warning).
#
# Audit-identity label for unauthenticated peers (audit-only, never a
# grant). Required to combine [audit] with an auth="none" listener.
# anonymous_principal = "local-dev"

[mechanisms]
# Path to the mechanism parameter registry served to shims over the
# GetBackendInterfaces RPC (unset = embedded default, compiled from
# mechanism_params_default.toml in the types crate). Set it only when
# layering vendor extensions (see
# packaging/config/mechanism_params.cloudhsm.toml.example). A set path
# must exist — the daemon refuses to start on a missing file.
# Override:  PKCS11_PROXY_MECHANISMS_CONFIG="/etc/pkcs11-proxy-ng/mechanism_params.toml"
# config_path = "/etc/pkcs11-proxy-ng/mechanism_params.toml"
