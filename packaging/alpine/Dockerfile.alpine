# syntax=docker/dockerfile:1
#
# Build pkcs11-proxy-ng APKs for a target Alpine version and stage them
# into a scratch carrier image at /apk. The consumer Dockerfile pattern
# is identical to the existing pkcs11-proxy distribution:
#
#   FROM ${PKCS11_PROXY_NG_IMAGE} AS pkcs11ng
#   RUN --mount=type=bind,from=pkcs11ng,source=/apk,target=/apk \
#       apk --no-cache add --allow-untrusted --repository /apk pkcs11-proxy-ng-shim
#
# Supported ALPINE_VER values for Phase 1: 3.22, 3.23. Older Alpine
# releases ship a Rust toolchain below the workspace MSRV (1.88) — the
# matrix is intentionally narrow.

ARG ALPINE_VER=3.23
ARG ALPINE_BUILD_IMAGE=alpine:${ALPINE_VER}
ARG READY_IMAGE=scratch

# Build metadata — supplied by CI (or auto-derived in the build stage).
ARG BUILD_DATE=unknown
ARG GIT_COMMIT=unknown

# ─── Stage 1: build APKs using rustup-managed Rust toolchain ──────────────────

FROM ${ALPINE_BUILD_IMAGE} AS buildapk

# Install build tooling. cargo/rust come from rustup rather than
# Alpine packages so the toolchain is uniform across the matrix and
# new enough for the workspace's transitive dependency MSRVs (Alpine
# 3.22 stock rust is 1.87, but libloading 0.9 / time 0.3.47 require
# 1.88+). See doc/audit/r1-implementation.md for the deviation
# rationale.
ENV RUSTUP_HOME=/usr/local/rustup
ENV CARGO_HOME=/usr/local/cargo
ENV PATH=/usr/local/cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Rustup's musl toolchain defaults to `crt-static`, which is fine for
# the daemon and CLI binaries but disables `cdylib` (required by the
# shim). Override so all crate-types compile; the daemon stays
# musl-linked just like before.
ENV RUSTFLAGS="-C target-feature=-crt-static"
RUN <<EOF
  set -eux
  apk add --no-cache alpine-sdk sudo protoc protobuf-dev curl gcc musl-dev openssl-dev bash
  curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs -o /tmp/rustup-init.sh
  sh /tmp/rustup-init.sh -y --default-toolchain stable --profile minimal --no-modify-path
  rm /tmp/rustup-init.sh
  test -x /usr/local/cargo/bin/cargo
  /usr/local/cargo/bin/rustc --version
  adduser -S -G abuild -D build
  echo "build ALL=(ALL) NOPASSWD: ALL" >> /etc/sudoers
  apk update
  mkdir /apk
  chown build:abuild /apk
  # Make the rustup toolchain visible to the build user, and the
  # cargo registry / registry-index cache writable so abuild's
  # cargo-build step can populate them.
  chmod -R a+rwX /usr/local/cargo
  chmod -R a+rX /usr/local/rustup
EOF

USER build
WORKDIR /home/build/

# Copy the workspace. The .dockerignore filters target/, .git/, and
# similar bulk so the build context stays small.
COPY --chown=build:abuild . .

# Build APKs from packaging/alpine/APKBUILD. abuild expects to be run
# from the directory containing the APKBUILD; the APKBUILD itself
# sets builddir="$startdir/../.." so it picks up the workspace root.
# REPODEST sends produced APKs straight into /apk so we do not need
# to chase abuild's default packages-per-reponame path layout.
ENV REPODEST=/apk
RUN <<EOF
  set -e
  cd packaging/alpine
  abuild-keygen -a -i -n
  abuild -r
  # abuild's actual storage layout is $REPODEST/$REPONAME/$CARCH/.
  # $REPONAME is the basename of the parent directory of the APKBUILD
  # (so here it ends up "packaging"). Downstream consumers expect to
  # pass --repository /apk and find /apk/$CARCH/APKINDEX.tar.gz, so
  # flatten that one level out.
  if [ -d /apk/packaging ]; then
    mv /apk/packaging/* /apk/
    rmdir /apk/packaging
  fi
  ls -lR /apk
  # Confirm every produced APK lives in the expected /apk/<arch>/ layout.
  for pkg in pkcs11-proxy-ng-shim pkcs11-proxy-ng-daemon \
             pkcs11-proxy-ng-cli pkcs11-proxy-ng-compat; do
    ls /apk/*/"${pkg}"-*.apk
  done
EOF

# ─── Stage 2: smoke-test install/uninstall ─────────────────────────────────

FROM ${ALPINE_BUILD_IMAGE} AS buildtest
COPY --from=buildapk /apk /apk

RUN <<EOF
  set -eu
  echo "smoke test: install each subpackage individually"
  for pkg in pkcs11-proxy-ng-shim pkcs11-proxy-ng-daemon \
             pkcs11-proxy-ng-cli pkcs11-proxy-ng-compat; do
    apk --no-cache add --allow-untrusted --repository /apk "$pkg"
    apk --no-cache del "$pkg"
  done
  echo "smoke test: install all together"
  apk --no-cache add --allow-untrusted --repository /apk \
    pkcs11-proxy-ng-shim \
    pkcs11-proxy-ng-daemon \
    pkcs11-proxy-ng-cli \
    pkcs11-proxy-ng-compat
  /usr/bin/pkcs11-proxy-ng --version
  /usr/bin/pkcs11-proxy-ng-cli --version
  test -f /usr/lib/pkcs11/libpkcs11_proxy_ng_shim.so
  test -L /usr/lib/libpkcs11-proxy.so
  apk --no-cache del pkcs11-proxy-ng-shim pkcs11-proxy-ng-daemon \
                     pkcs11-proxy-ng-cli pkcs11-proxy-ng-compat
EOF

# ─── Stage 3: final carrier image ──────────────────────────────────────────

FROM ${READY_IMAGE}

ARG BUILD_DATE
ARG GIT_COMMIT

COPY --from=buildtest /apk /apk

LABEL org.opencontainers.image.title="pkcs11-proxy-ng"
LABEL org.opencontainers.image.description="Rust PKCS#11 remote proxy APKs (carrier image)"
LABEL org.opencontainers.image.vendor="Laavat Oy"
LABEL org.opencontainers.image.licenses="Apache-2.0 OR MIT"
LABEL org.opencontainers.image.created="${BUILD_DATE}"
LABEL org.opencontainers.image.revision="${GIT_COMMIT}"
