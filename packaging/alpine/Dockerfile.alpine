# syntax=docker/dockerfile:1
#
# Build pkcs11-proxy-ng APKs for a target Alpine version and stage them
# into a scratch carrier image at /apk. The consumer Dockerfile pattern
# is identical to the existing pkcs11-proxy distribution:
#
#   FROM ${PKCS11_PROXY_NG_IMAGE} AS pkcs11ng
#   RUN --mount=type=bind,from=pkcs11ng,source=/apk,target=/apk \
#       apk --no-cache add --allow-untrusted --repository /apk pkcs11-proxy-ng-shim
#
# Supported ALPINE_VER values for Phase 1: 3.22, 3.23. Older Alpine
# releases ship a Rust toolchain below the workspace MSRV (1.85) — the
# matrix is intentionally narrow.

ARG ALPINE_VER=3.23
ARG ALPINE_BUILD_IMAGE=alpine:${ALPINE_VER}
ARG READY_IMAGE=scratch

# Build metadata — supplied by CI (or auto-derived in the build stage).
ARG BUILD_DATE=unknown
ARG GIT_COMMIT=unknown

# ─── Stage 1: build APKs using stock Alpine toolchain ──────────────────────

FROM ${ALPINE_BUILD_IMAGE} AS buildapk

RUN <<EOF
  apk add --no-cache alpine-sdk sudo cargo rust
  adduser -S -G abuild -D build
  echo "build ALL=(ALL) NOPASSWD: ALL" >> /etc/sudoers
  apk update
  mkdir /apk
  chown build:abuild /apk
EOF

USER build
WORKDIR /home/build/

# Copy the workspace. The .dockerignore filters target/, .git/, and
# similar bulk so the build context stays small.
COPY --chown=build:abuild . .

# Build APKs from packaging/alpine/APKBUILD. abuild expects to be run
# from the directory containing the APKBUILD; pkgname-relative paths
# inside the APKBUILD resolve against $builddir (set to the parent of
# APKBUILD by abuild itself).
RUN <<EOF
  cd packaging/alpine
  abuild-keygen -a -i -n
  abuild -r
  mv /home/build/packages/alpine/* /apk/ 2>/dev/null || true
  # The default abuild output path varies by configuration; cover the
  # common roots that may hold the produced APKs.
  for src in /home/build/packages/* ; do
    [ -d "$src" ] && cp -a "$src"/* /apk/ 2>/dev/null || true
  done
  apk info -a --repository /apk pkcs11-proxy-ng-shim || true
  apk info -a --repository /apk pkcs11-proxy-ng-daemon || true
  apk info -a --repository /apk pkcs11-proxy-ng-cli || true
  apk info -a --repository /apk pkcs11-proxy-ng-compat || true
EOF

# ─── Stage 2: smoke-test install/uninstall ─────────────────────────────────

FROM ${ALPINE_BUILD_IMAGE} AS buildtest
COPY --from=buildapk /apk /apk

RUN <<EOF
  set -eu
  echo "smoke test: install each subpackage individually"
  for pkg in pkcs11-proxy-ng-shim pkcs11-proxy-ng-daemon \
             pkcs11-proxy-ng-cli pkcs11-proxy-ng-compat; do
    apk --no-cache add --allow-untrusted --repository /apk "$pkg"
    apk --no-cache del "$pkg"
  done
  echo "smoke test: install all together"
  apk --no-cache add --allow-untrusted --repository /apk \
    pkcs11-proxy-ng-shim \
    pkcs11-proxy-ng-daemon \
    pkcs11-proxy-ng-cli \
    pkcs11-proxy-ng-compat
  /usr/bin/pkcs11-proxy-ng --version
  /usr/bin/pkcs11-proxy-ng-cli --version
  test -f /usr/lib/pkcs11/libpkcs11_proxy_ng_shim.so
  test -L /usr/lib/libpkcs11-proxy.so
  apk --no-cache del pkcs11-proxy-ng-shim pkcs11-proxy-ng-daemon \
                     pkcs11-proxy-ng-cli pkcs11-proxy-ng-compat
EOF

# ─── Stage 3: final carrier image ──────────────────────────────────────────

FROM ${READY_IMAGE}

ARG BUILD_DATE
ARG GIT_COMMIT

COPY --from=buildtest /apk /apk

LABEL org.opencontainers.image.title="pkcs11-proxy-ng"
LABEL org.opencontainers.image.description="Rust PKCS#11 remote proxy APKs (carrier image)"
LABEL org.opencontainers.image.vendor="Laavat Oy"
LABEL org.opencontainers.image.licenses="Apache-2.0 OR MIT"
LABEL org.opencontainers.image.created="${BUILD_DATE}"
LABEL org.opencontainers.image.revision="${GIT_COMMIT}"
