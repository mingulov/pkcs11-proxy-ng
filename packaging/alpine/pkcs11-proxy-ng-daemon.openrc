#!/sbin/openrc-run
# shellcheck shell=sh

# OpenRC service unit for pkcs11-proxy-ng on Alpine.
#
# Disabled by default — the post-install message tells operators to
# edit /etc/pkcs11-proxy-ng/proxy.toml first and then run
# `rc-service pkcs11-proxy-ng start`.

name="pkcs11-proxy-ng"
description="Rust PKCS#11 remote proxy daemon"
command="/usr/bin/pkcs11-proxy-ng"
command_args="/etc/pkcs11-proxy-ng/proxy.toml"
command_user="root"
command_background="yes"
pidfile="/run/${name}.pid"
output_log="/var/log/${name}.log"
error_log="/var/log/${name}.log"

# Supervise the daemon so abnormal stops — including the native-lifetime
# exit_group(70) stop (see doc/runbooks/operating-pkcs11-proxy-ng.md and
# doc/release/native-mechanism-ownership.md) — respawn it instead of
# leaving it down. This is the OpenRC equivalent of the systemd unit's
# Restart=on-failure. The daemon runs in the foreground (it never forks),
# which supervise-daemon requires; command_background above is inert while
# the supervisor is set. The respawn cap stops a persistently-fatal daemon
# from hot-looping forever.
supervisor="supervise-daemon"
respawn_delay=5
respawn_max=10
respawn_period=300

depend() {
    need net
    after firewall
}
