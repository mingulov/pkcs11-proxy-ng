# syntax=docker/dockerfile:1
#
# Build pkcs11-proxy-ng RPMs for Amazon Linux 2023 and stage them into a
# scratch carrier image at /rpm. Mirrors the Alpine pattern.
#
# Consumer Dockerfile pattern:
#
#   FROM ${PKCS11_PROXY_NG_IMAGE} AS pkcs11ng
#   FROM amazonlinux:2023 AS final
#   RUN --mount=type=bind,from=pkcs11ng,source=/rpm,target=/rpm \
#       dnf install -y /rpm/pkcs11-proxy-ng-shim-*.rpm

# Deferred T22 F6: base pinned by digest (tag kept for readability; the
# digest is what Docker pulls; resolved live 2026-09-22). CI passes the
# same image explicitly (.gitlab-ci.yml); local builds override with
# --build-arg AMAZON_BUILD_IMAGE=<pinned image>. Re-pin with the
# registry's current digest when moving Amazon Linux versions.
ARG AMAZON_BUILD_IMAGE=amazonlinux:2023@sha256:74c545e3e04db388b00bd31d7cc5640d4e9c12058a6d72af938d113da3c82893
ARG READY_IMAGE=scratch
ARG APP_VERSION=0.2.2
ARG BUILD_DATE=unknown
ARG GIT_COMMIT=unknown

# ─── Stage 1: build RPMs using rustup-managed Rust toolchain ──────────────────

FROM ${AMAZON_BUILD_IMAGE} AS buildrpm
ENV CARGO_BUILD_JOBS=4
ENV CARGO_INCREMENTAL=0

# Deferred T22 F6: versioned rustup bootstrap (not the floating
# install pipe) installing the receipted toolchain, with the init
# binary's SHA256 verified before execute. Hashes below are the
# published static.rust-lang.org rustup-init.sha256 values for 1.29.1.
ARG RUSTUP_VERSION=1.29.1
ARG RUST_TOOLCHAIN=1.98.1
ARG RUSTUP_SHA256_AMD64=dda7234360b7f578ca8b0ddcb80145646fa61a67c1720a5abc7051b35c9fcb71
ARG RUSTUP_SHA256_ARM64=15f6e4ce9f583b929c996c91562bad6d4454f3281de858b02cdfdef615fac433

ARG APP_VERSION

WORKDIR /root

COPY . .

RUN <<EOF
  set -eu
  dnf -y update
  # `curl` is intentionally omitted because AL2023 ships curl-minimal
  # by default and a non-minimal curl install conflicts. The minimal
  # curl is sufficient for the rustup bootstrap below.
  dnf -y install gcc make rpm-build rpmdevtools tar gzip protobuf-compiler systemd-rpm-macros python3.11
  python3.11 -c 'import tomllib'
  # AL2023's stock rust/cargo (typically 1.86) is below transitive
  # dependency MSRV (libloading 0.9, time 0.3.47 require 1.88+). The
  # build therefore uses rustup; see doc/development.md for the
  # supported toolchain and MSRV checks.
  # The toolchain version is pinned (RUST_TOOLCHAIN) and the rustup-init
  # binary is SHA-verified (RUSTUP_VERSION + RUSTUP_SHA256_*).
  ARCH="$(uname -m)"
  case "$ARCH" in
    x86_64)  RUST_TRIPLE=x86_64-unknown-linux-gnu;  RUSTUP_SHA256="${RUSTUP_SHA256_AMD64}" ;;
    aarch64) RUST_TRIPLE=aarch64-unknown-linux-gnu; RUSTUP_SHA256="${RUSTUP_SHA256_ARM64}" ;;
    *) echo "unsupported arch $ARCH" >&2; exit 1 ;;
  esac
  curl --proto '=https' --tlsv1.2 -sSf "https://static.rust-lang.org/rustup/archive/${RUSTUP_VERSION}/${RUST_TRIPLE}/rustup-init" -o /tmp/rustup-init
  echo "${RUSTUP_SHA256}  /tmp/rustup-init" | sha256sum -c -
  chmod +x /tmp/rustup-init
  /tmp/rustup-init -y --default-toolchain "${RUST_TOOLCHAIN}" --profile minimal --no-modify-path
  rm /tmp/rustup-init
  . "$HOME/.cargo/env"
  rpmdev-setuptree
  mkdir -p /rpm

  # The spec builds from this complete source tarball and generates
  # workspace-labeled notices after compilation.
  source_name="pkcs11-proxy-ng-${APP_VERSION}"
  source_dir="$HOME/rpmbuild/SOURCES/$source_name"
  mkdir -p "$source_dir"
  cp -a Cargo.toml Cargo.lock README.md LICENSE-APACHE LICENSE-MIT "$source_dir/"
  cp -a scripts packaging crates "$source_dir/"
  cd ~/rpmbuild/SOURCES
  tar -czf "$source_name.tar.gz" "$source_name"

  cp /root/packaging/amazon/pkcs11-proxy-ng.spec ~/rpmbuild/SPECS/
  # The spec %build uses rustup cargo and the explicit python3.11
  # interpreter, leaving AL2023's system /usr/bin/python3 unchanged.
  PATH="$HOME/.cargo/bin:$PATH" rpmbuild -ba ~/rpmbuild/SPECS/pkcs11-proxy-ng.spec
  cp ~/rpmbuild/RPMS/x86_64/*.rpm /rpm/
EOF

# ─── Stage 2: smoke-test install/uninstall ─────────────────────────────────

FROM ${AMAZON_BUILD_IMAGE} AS buildtest
COPY --from=buildrpm /rpm /rpm

RUN <<EOF
  set -eu
  echo "smoke test: install each subpackage"
  for pkg in pkcs11-proxy-ng-shim pkcs11-proxy-ng-daemon pkcs11-proxy-ng-cli; do
    dnf -y install /rpm/"${pkg}"-*.rpm
    for item in LICENSE-APACHE LICENSE-MIT THIRD_PARTY_NOTICES \
                notice-inventory.json build-provenance.json \
                license-material/ring-0.17.14/licenses/LICENSE \
                license-material/rust-std/COPYRIGHT-library.html; do
      test -s "/usr/share/licenses/$pkg/$item"
    done
  done
  dnf -y install /rpm/pkcs11-proxy-ng-compat-*.rpm
  /usr/bin/pkcs11-proxy-ng --version
  /usr/bin/pkcs11-proxy-ng-cli --version
  test -f /usr/lib64/pkcs11/libpkcs11_proxy_ng_shim.so
  test -L /usr/lib64/libpkcs11-proxy.so
  dnf -y remove pkcs11-proxy-ng-compat pkcs11-proxy-ng-cli \
                 pkcs11-proxy-ng-daemon pkcs11-proxy-ng-shim
EOF

# ─── Stage 3: final carrier image ──────────────────────────────────────────

FROM ${READY_IMAGE}

ARG BUILD_DATE
ARG GIT_COMMIT

COPY --from=buildtest /rpm /rpm

LABEL org.opencontainers.image.title="pkcs11-proxy-ng"
LABEL org.opencontainers.image.description="Rust PKCS#11 remote proxy RPMs (carrier image)"
LABEL org.opencontainers.image.vendor="pkcs11-proxy-ng maintainers"
LABEL org.opencontainers.image.source="https://github.com/mingulov/pkcs11-proxy-ng"
LABEL org.opencontainers.image.licenses="Apache-2.0 OR MIT"
LABEL org.opencontainers.image.created="${BUILD_DATE}"
LABEL org.opencontainers.image.revision="${GIT_COMMIT}"
