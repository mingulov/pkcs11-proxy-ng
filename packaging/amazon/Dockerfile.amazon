# syntax=docker/dockerfile:1
#
# Build pkcs11-proxy-ng RPMs for Amazon Linux 2023 and stage them into a
# scratch carrier image at /rpm. Mirrors the Alpine pattern.
#
# Consumer Dockerfile pattern:
#
#   FROM ${PKCS11_PROXY_NG_IMAGE} AS pkcs11ng
#   FROM amazonlinux:2023 AS final
#   RUN --mount=type=bind,from=pkcs11ng,source=/rpm,target=/rpm \
#       dnf install -y /rpm/pkcs11-proxy-ng-shim-*.rpm

ARG AMAZON_VER=2023
ARG AMAZON_BUILD_IMAGE=amazonlinux:${AMAZON_VER}
ARG READY_IMAGE=scratch
ARG BUILD_DATE=unknown
ARG GIT_COMMIT=unknown

# ─── Stage 1: build RPMs using stock AL2023 toolchain ──────────────────────

FROM ${AMAZON_BUILD_IMAGE} AS buildrpm

WORKDIR /root

COPY . .

RUN <<EOF
  set -eu
  dnf -y update
  # `curl` is intentionally omitted because AL2023 ships curl-minimal
  # by default and a non-minimal curl install conflicts. The minimal
  # curl is sufficient for the rustup bootstrap below.
  dnf -y install gcc make rpm-build rpmdevtools tar gzip protobuf-compiler systemd-rpm-macros
  # AL2023's stock rust/cargo (typically 1.86) is below transitive
  # dependency MSRV (libloading 0.9, time 0.3.47 require 1.88+). The
  # design's "use stock Rust" preference yields to "AL2023 must be in
  # Phase 1" — see doc/audit/r1-implementation.md for the deviation.
  curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | \
      sh -s -- -y --default-toolchain stable --profile minimal --no-modify-path
  . "$HOME/.cargo/env"
  rpmdev-setuptree
  mkdir -p /rpm

  # Build the workspace with the rustup-installed toolchain.
  cargo build --release --workspace --locked

  # Stage a source tarball that the .spec file consumes. The tarball
  # includes the target/release artifacts so the .spec's %install
  # phase can pick them up without rebuilding.
  mkdir -p ~/rpmbuild/SOURCES/pkcs11-proxy-ng-0.2.0
  cp -a target ~/rpmbuild/SOURCES/pkcs11-proxy-ng-0.2.0/target
  cp -a packaging crates ~/rpmbuild/SOURCES/pkcs11-proxy-ng-0.2.0/
  cd ~/rpmbuild/SOURCES
  tar -czf pkcs11-proxy-ng-0.2.0.tar.gz pkcs11-proxy-ng-0.2.0

  cp /root/packaging/amazon/pkcs11-proxy-ng.spec ~/rpmbuild/SPECS/
  # The .spec %build re-runs `cargo build` from inside rpmbuild; pass
  # the rustup cargo via PATH so it picks up the same toolchain
  # without re-downloading. Disable rpmbuild's debug split (already
  # done in the .spec) so AL2023's strict-build defaults don't trip.
  PATH="$HOME/.cargo/bin:$PATH" rpmbuild -ba ~/rpmbuild/SPECS/pkcs11-proxy-ng.spec
  cp ~/rpmbuild/RPMS/x86_64/*.rpm /rpm/
EOF

# ─── Stage 2: smoke-test install/uninstall ─────────────────────────────────

FROM ${AMAZON_BUILD_IMAGE} AS buildtest
COPY --from=buildrpm /rpm /rpm

RUN <<EOF
  set -eu
  echo "smoke test: install each subpackage"
  dnf -y install /rpm/pkcs11-proxy-ng-shim-*.rpm
  dnf -y install /rpm/pkcs11-proxy-ng-daemon-*.rpm
  dnf -y install /rpm/pkcs11-proxy-ng-cli-*.rpm
  dnf -y install /rpm/pkcs11-proxy-ng-compat-*.rpm
  /usr/bin/pkcs11-proxy-ng --version
  /usr/bin/pkcs11-proxy-ng-cli --version
  test -f /usr/lib64/pkcs11/libpkcs11_proxy_ng_shim.so
  test -L /usr/lib64/libpkcs11-proxy.so
  dnf -y remove pkcs11-proxy-ng-compat pkcs11-proxy-ng-cli \
                 pkcs11-proxy-ng-daemon pkcs11-proxy-ng-shim
EOF

# ─── Stage 3: final carrier image ──────────────────────────────────────────

FROM ${READY_IMAGE}

ARG BUILD_DATE
ARG GIT_COMMIT

COPY --from=buildtest /rpm /rpm

LABEL org.opencontainers.image.title="pkcs11-proxy-ng"
LABEL org.opencontainers.image.description="Rust PKCS#11 remote proxy RPMs (carrier image)"
LABEL org.opencontainers.image.vendor="Laavat Oy"
LABEL org.opencontainers.image.licenses="Apache-2.0 OR MIT"
LABEL org.opencontainers.image.created="${BUILD_DATE}"
LABEL org.opencontainers.image.revision="${GIT_COMMIT}"
